<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- vp-11-reminders: avisos de fim de prazo de estacionamento.
         SCHEDULE_EXACT_ALARM e pedido ao utilizador no Android 12+; quando nao
         e concedido a app degrada para alarme inexato em vez de falhar.
         USE_EXACT_ALARM nao e pedido de proposito: a Play Store so o aceita em
         apps de alarme/calendario e esta nao e nenhuma das duas. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- vp-16-android-auto: obrigatoria nas apps POI para usar o
         PlaceListMapTemplate; sem ela o host recusa o ecra do mapa. -->
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />

    <!-- Seccao 25: visibilidade do pacote necessaria para resolver o esquema geo:.
         O google.navigation: e o unico que aceita modo a pe (vp-09-return-route);
         sem esta entrada a resolucao falharia sempre e a app cairia no geo:. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
    </queries>

    <application
        android:name=".VccParkingApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VCCParking">

        <!-- vp-16-android-auto: sem este meta-data o Android Auto nao reconhece
             a aplicacao, mesmo com o CarAppService declarado. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Nenhum dos templates usados exige nivel superior; o 1 abrange todos
             os hosts, incluindo os veiculos mais antigos. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.VCCParking">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- vp-16-android-auto: interface projetada no ecra do carro.
             Tem de ser exportado para o host do Android Auto lhe poder ligar;
             quem se pode ligar e decidido pelo HostValidator do servico, e nao
             por uma permissao do manifest. -->
        <service
            android:name=".car.VccParkingCarAppService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>

        <!-- vp-11-reminders: nenhum destes recetores e exportado. Os alarmes e
             as accoes das notificacoes sao disparados pela propria app, e deixar
             qualquer outra app terminar o estacionamento seria um erro. -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.ReminderActionReceiver"
            android:exported="false" />

        <!-- A excecao: o BOOT_COMPLETED vem do sistema, por isso tem de aceitar
             um emissor externo, mas so para essa accao. -->
        <receiver
            android:name=".reminder.BootCompletedReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
